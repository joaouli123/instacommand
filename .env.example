# ==================================
# InstaCommand — Environment Variables
# ==================================
# Copy this file to .env and fill in your values

# ---- Database (PostgreSQL) ----
DB_HOST=postgres
DB_PORT=5432
DB_USER=instacommand
DB_PASSWORD=instacommand_secret
DB_NAME=instacommand
DATABASE_URL=postgresql://instacommand:instacommand_secret@localhost:5432/instacommand?schema=public

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- Meta / Facebook App ----
# Create your app at https://developers.facebook.com/
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v25.0
FB_LOGIN_CONFIG_ID=2156831831569762
FB_OAUTH_HOST=www.facebook.com
# These eight scopes are supplied by this dedicated configuration. FB_OAUTH_SCOPES is only a fallback when FB_LOGIN_CONFIG_ID is empty.
FB_OAUTH_SCOPES=business_management,instagram_basic,instagram_content_publish,instagram_manage_comments,instagram_manage_messages,pages_manage_metadata,pages_read_engagement,pages_show_list

# ---- Threads App (can also be configured per workspace in the UI) ----
THREADS_APP_ID=your_threads_app_id
THREADS_APP_SECRET=your_threads_app_secret
THREADS_REDIRECT_URI=http://localhost:3001/api/auth/threads/callback

# ---- Gemini / AI (server default; each workspace may override Gemini in Settings) ----
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---- Auth ----
JWT_SECRET=change_this_to_a_random_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_this_to_another_random_secret

# ---- Backend Server ----
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_to_yet_another_random_secret

# ---- Instagram Webhook ----
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# ---- Media Upload ----
# Directory to store uploaded media (must be publicly accessible)
MEDIA_UPLOAD_DIR=./uploads
MEDIA_PUBLIC_URL=http://localhost:3001/uploads

# ---- Encryption ----
# Keep this value stable after the first deploy. Use at least 32 random characters.
ENCRYPTION_KEY=change_this_to_a_long_random_encryption_key

# ---- Insights Collection Schedule (cron) ----
INSIGHTS_CRON=0 */6 * * *
COMPETITORS_CRON=0 3 * * *
TOKEN_REFRESH_CRON=0 0 * * 0
