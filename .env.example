# ==================================
# InstaCommand — Environment Variables
# ==================================
# Copy this file to .env and fill in your values

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=instacommand
DB_PASSWORD=instacommand_secret
DB_NAME=instacommand
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ---- Meta / Facebook App ----
# Create your app at https://developers.facebook.com/
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v22.0

# ---- Auth ----
JWT_SECRET=change_this_to_a_random_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_this_to_another_random_secret

# ---- Backend Server ----
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001

# ---- Frontend ----
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_to_yet_another_random_secret

# ---- Instagram Webhook ----
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# ---- Media Upload ----
# Directory to store uploaded media (must be publicly accessible)
MEDIA_UPLOAD_DIR=./uploads
MEDIA_PUBLIC_URL=http://localhost:3001/uploads

# ---- Insights Collection Schedule (cron) ----
INSIGHTS_CRON=0 */6 * * *
COMPETITORS_CRON=0 3 * * *
TOKEN_REFRESH_CRON=0 0 * * 0
